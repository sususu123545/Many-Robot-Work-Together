# 换行符策略
#
# 背景：车端是 Linux（树莓派 / Docker 容器），脚本带 \r 会直接报
#   bash: ./run_ascam_hp60c.sh: /bin/bash^M: bad interpreter: No such file or directory
# 而 Windows 的 .bat 又必须是 CRLF，否则 cmd 可能解析异常。
# 所以：默认一律 LF，只有批处理强制 CRLF。

* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf

# 明确按文本处理（避免被当二进制）
*.sh     text eol=lf
*.py     text eol=lf
*.launch text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf

# 图片等二进制，别做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.d6a binary
