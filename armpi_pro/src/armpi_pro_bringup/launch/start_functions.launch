<launch>

  <!-- 视觉功能是可选能力，不能让相机/算法异常拖垮底盘、雷达和 SLAM 启动链。 -->
  <node name="visual_processing" pkg="visual_processing" type="visual_processing_node.py" required="false" output="screen">
    <param name="image_topic" value="/rear_camera/image_raw" />
  </node>

  <node name="face_detect" pkg="face_detect" type="face_detect_node.py" required="false" output="screen" />
  <node name="visual_patrol" pkg="visual_patrol" type="visual_patrol_node.py" required="false" output="screen" />
  <node name="color_tracking" pkg="color_tracking" type="color_tracking_node.py" required="false" output="screen" />
  <node name="apriltag_detect" pkg="apriltag_detect" type="apriltag_detect_node.py" required="false" output="screen" />

</launch>
