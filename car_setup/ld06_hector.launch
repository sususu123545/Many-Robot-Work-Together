<launch>
  <!-- LD06 + hector_slam 建图 (已接入轮式里程计, 2026-09-18)
       依赖:
         - ld06.launch   已在跑 → 发布 /scan + base_link->base_laser 静态 tf
         - odom.service  已在跑 → 发布 /odom + odom->base_link tf
       odom_frame=odom => hector 拿轮式里程计做扫描匹配的运动初值,
                          并自己发布 map->odom
       完整 TF 链: map -> odom -> base_link -> base_laser
       (旧配置是 odom_frame=base_link 的"无里程计方案", 会与 odom 节点抢 base_link) -->
  <arg name="scan_topic" default="scan"/>
  <arg name="map_size"   default="384"/>
  <arg name="map_resolution" default="0.05"/>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame"  value="map"/>
    <param name="pub_map_odom_transform" value="true"/>
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="map_size" value="$(arg map_size)"/>
    <param name="map_resolution" value="$(arg map_resolution)"/>
    <!-- ⭐ 09-18 修正: 原值 0.04/0.08 比 hector 默认(0.4/0.9)激进 10 倍,
         车稍微动一点就重画 -> 同一面墙被写到相邻错位格 -> "黑白交错/锯齿边"。
         改成中间值: 既跟得上遥控慢速移动, 又不至于抖动就重画。 -->
    <param name="map_update_distance_thresh" value="0.1"/>
    <param name="map_update_angle_thresh"    value="0.2"/>
    <param name="laser_min_dist" value="0.40"/>
    <param name="laser_max_dist" value="8.0"/>
  </node>
</launch>
