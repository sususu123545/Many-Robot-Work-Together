# Execute a predicted chunk, one gated action at a time.
#
# The observation and the chunk travel together because the chunk's deltas are
# only meaningful relative to that observation's pose. Splitting them into two
# topics invites a race where a fresh pose is paired with a stale plan.
string goal_id
vla_interfaces/VlaObservation observation
vla_interfaces/VlaActionChunk chunk
---

bool success
string reason_code
string reason

# How many actions the client sent, how many reached the hardware, and how many
# the safety layer refused. requested != executed + rejected means the goal was
# preempted or the chunk expired mid-flight.
uint32 requested
uint32 executed
uint32 rejected

# Smallest scale the filter had to apply. < 1.0 means the policy was asking for
# more motion than the platform permits and is worth surfacing in evaluation.
float64 min_scale_applied

string[] reject_codes
---

uint32 index
uint32 total

# One of: waiting_for_health, executing, preempted, rejected, expired, done.
string state

vla_interfaces/VlaSafetyVerdict last_verdict
